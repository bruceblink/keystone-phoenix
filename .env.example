POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=keystone_phoenix_dev
CAPTCHA_TYPE=math
FILE_BASE_DIR=uploads
JWT_ACCESS_TTL=300
JWT_REFRESH_TTL=1209600
JWT_AUDIENCE=keystone-api
JWT_KEY_ID=keystone
MFA_MASTER_KEY=base64-encoded-32-byte-key
MFA_MASTER_KEY_VERSION=1
MFA_RECOVERY_PEPPER=replace-with-at-least-16-random-bytes
MFA_CHALLENGE_LIFETIME_SECONDS=300
# Production must provide a PEM encoded RSA private key for RS256 and login
# password decryption. The public key is derived from it when omitted.
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Production release settings
DATABASE_URL=ecto://postgres:postgres@localhost/keystone_phoenix_prod
SECRET_KEY_BASE=replace-with-mix-phx-gen-secret-output
PHX_HOST=localhost
# 生产环境默认强制 HTTPS。仅本地 HTTP smoke 可同时设置以下两个变量为 false/true。
PHX_FORCE_SSL=true
PHX_ALLOW_INSECURE_HTTP=false
# 逗号分隔的完整来源地址；生产来源必须使用 https://，留空表示不允许跨域读取。
CORS_ALLOWED_ORIGINS=
# 只有这些反向代理来源地址可以提供 x-forwarded-proto=https；留空时只信任实际 HTTPS 连接。
TRUSTED_PROXY_CIDRS=
# OIDC 默认关闭。启用时必须同时配置 issuer、endpoint、client 和精确回调地址。
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_JWKS_URI=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4000/api/v1/auth/oidc/callback
OIDC_AUDIENCE=
OIDC_SCOPES=openid profile email
OIDC_CODE_TTL_SECONDS=300
OIDC_AUTO_PROVISION=false
PORT=4000
POOL_SIZE=10
JOB_SCHEDULER_ENABLED=true
JOB_SCHEDULER_INTERVAL_MS=1000
JOB_TASK_MAX_CHILDREN=64
JOB_EXECUTION_TIMEOUT_MS=30000
