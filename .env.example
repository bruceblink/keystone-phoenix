POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=keystone_phoenix_dev
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
JWT_ACCESS_TTL=1800
JWT_REFRESH_TTL=604800
# Production must provide PEM encoded RSA keys for RS256.
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Production release settings
DATABASE_URL=ecto://postgres:postgres@localhost/keystone_phoenix_prod
SECRET_KEY_BASE=replace-with-mix-phx-gen-secret-output
PHX_HOST=localhost
PORT=4000
POOL_SIZE=10
